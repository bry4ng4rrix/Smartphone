# Copier vers `.env` (jamais commité) et remplir avant `docker compose up`.
# Utilisé par docker-compose.prod.yml — voir roadmap.md pour le détail de
# chaque variable et le déploiement complet sur le VPS.

# ---------- Django ----------
# Générer avec : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DEBUG=False
ALLOWED_HOSTS=votre-domaine.mg 157.173.103.147 localhost
CORS_ALLOWED_ORIGINS=https://votre-domaine.mg
CSRF_TRUSTED_ORIGINS=https://votre-domaine.mg

# ---------- Base de données (Postgres, service `db` du compose) ----------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=stock_db
DB_USER=stock
DB_PASSWORD=change-me-strong-password
DB_HOST=db
DB_PORT=5432

# ---------- Ports hôte (volontairement non-standards pour cohabiter avec
# d'autres projets sur le même Docker — Postgres/Redis ne sont eux jamais
# exposés à l'hôte, voir docker-compose.prod.yml) ----------
BACKEND_PORT=8010
FRONTEND_PORT=3010

# ---------- Frontend (Next.js) ----------
# Inlinée dans le bundle au build (voir frontend/Dockerfile) — l'URL doit
# être joignable depuis le NAVIGATEUR du client, pas seulement depuis le
# conteneur (donc le domaine/IP public, pas "backend" ni "127.0.0.1").
NEXT_PUBLIC_DJANGO_API_URL=https://votre-domaine.mg:8010/api
